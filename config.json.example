{
  "_comment": "Copy to .pi/herd/config.json and edit. Omitted fields inherit package defaults (config.json). This example customizes glyphs, slows the heartbeat, and switches collision to auto-suffix.",
  "glyphs": {
    "agentFilled": "●",
    "agentOutline": "○"
  },
  "intervals": {
    "heartbeatMs": 3000,
    "widgetRefreshMs": 1500
  },
  "spawn": {
    "collisionPolicy": "auto-suffix"
  }
}
