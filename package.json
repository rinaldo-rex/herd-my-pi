{
  "name": "herd-my-pi",
  "version": "0.2.0",
  "description": "Spawn a herd of interactive pi sub-agents from templates, via herdr-core (hc), each in its own Herdr tab.",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rinaldo-rex/herd-my-pi.git"
  },
  "homepage": "https://github.com/rinaldo-rex/herd-my-pi#readme",
  "bugs": {
    "url": "https://github.com/rinaldo-rex/herd-my-pi/issues"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "pnpm@12.18.0",
  "files": [
    "extensions/*.ts",
    "src/*.ts",
    "agents/*.md",
    "skills/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/herd.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "check": "pnpm test && pnpm typecheck && pnpm pack:check",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "pack:check": "node tests/pack-check.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@types/node": "24.19.2",
    "typebox": "1.3.27",
    "typescript": "7.0.2"
  }
}
